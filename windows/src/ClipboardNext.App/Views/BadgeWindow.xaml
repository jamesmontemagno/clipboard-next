<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClipboardNext.App.BadgeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!--  The whole badge is the drag surface. Paired elements swap by visibility so every color stays a theme resource.  -->
    <Grid
        x:Name="RootGrid"
        AllowFocusOnInteraction="False"
        AutomationProperties.AutomationId="FloatingBadge"
        Background="Transparent"
        PointerCanceled="OnPointerCaptureEnded"
        PointerCaptureLost="OnPointerCaptureEnded"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased">
        <Border
            x:Name="RestingFrame"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8" />
        <Border
            x:Name="DetectedFrame"
            BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
            BorderThickness="2"
            CornerRadius="8"
            Visibility="Collapsed" />

        <Grid
            x:Name="BadgeContent"
            Margin="10,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleColumn" Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="16"
                Margin="0,0,7,0"
                VerticalAlignment="Center">
                <FontIcon
                    x:Name="ClipboardIcon"
                    Glyph="&#xF0E3;"
                    Style="{StaticResource AccentIconStyle}" />
                <FontIcon
                    x:Name="DetectedIcon"
                    Glyph="&#xE73E;"
                    Style="{StaticResource SuccessIconStyle}"
                    Visibility="Collapsed" />
            </Grid>
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                Margin="0,0,7,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="TitleSeparator"
                Grid.Column="2"
                Margin="0,0,7,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="&#xB7;"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="PositionText"
                Grid.Column="3"
                Margin="0,0,7,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Text="0/0" />
            <Grid
                Grid.Column="4"
                Width="6"
                Height="6"
                VerticalAlignment="Center">
                <Ellipse x:Name="IdleDot" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                <Ellipse
                    x:Name="RunningDot"
                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
