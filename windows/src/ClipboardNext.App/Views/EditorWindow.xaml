<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClipboardNext.App.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClipboardNext.App"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="Clipboard Next">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Native WinUI title bar: icon, drag region, and caption buttons.  -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Clipboard Next"
            AutomationProperties.AutomationId="EditorTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid x:Name="QueuePage" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header: what the queue is doing, and the transport controls.  -->
            <Grid Padding="24,8,24,16" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Demo queue" />
                    <TextBlock
                        x:Name="StatusText"
                        AutomationProperties.AutomationId="EditorStatusText"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource SecondaryBodyTextStyle}" />
                </StackPanel>
                <Button
                    x:Name="StartHereButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="StartHereButton"
                    Click="OnStartHereClick"
                    Content="Start here"
                    ToolTipService.ToolTip="Start the queue from the selected snippet" />
                <local:QueueControls
                    x:Name="Controls"
                    Grid.Column="2"
                    Width="330"
                    VerticalAlignment="Center" />
            </Grid>

            <Grid
                Grid.Row="1"
                Margin="24,0"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="320" />
                    <ColumnDefinition Width="3*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!--  The queue, in order.  -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView
                            x:Name="SnippetList"
                            Padding="0,4"
                            AutomationProperties.AutomationId="SnippetList"
                            AutomationProperties.Name="Snippets"
                            SelectionChanged="OnSnippetSelectionChanged"
                            SelectionMode="Single" />

                        <StackPanel
                            x:Name="EmptyQueueState"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                            <FontIcon Glyph="&#xF0E3;" Style="{StaticResource EmptyStateIconStyle}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Build your demo queue" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="Add snippets or import Markdown or plain text."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid
                            x:Name="ListCommands"
                            Grid.Row="1"
                            Padding="8"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="AddButton"
                                AutomationProperties.AutomationId="AddSnippetButton"
                                AutomationProperties.Name="Add snippet"
                                Click="OnAddClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock Text="Add" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ClearAllButton"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="ClearAllButton"
                                AutomationProperties.Name="Clear all snippets">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    <TextBlock Text="Clear all" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="ClearAllFlyout" Placement="Top">
                                        <StackPanel MaxWidth="280" Spacing="12">
                                            <TextBlock
                                                x:Name="ClearAllPrompt"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Text="This removes every snippet from the queue. It can't be undone."
                                                TextWrapping="Wrap" />
                                            <Button
                                                AutomationProperties.AutomationId="ConfirmClearAllButton"
                                                Click="OnClearAllConfirmed"
                                                Content="Clear all" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button
                                x:Name="MoveUpButton"
                                Grid.Column="3"
                                AutomationProperties.AutomationId="MoveUpButton"
                                AutomationProperties.Name="Move up"
                                Click="OnMoveUpClick"
                                ToolTipService.ToolTip="Move up">
                                <FontIcon FontSize="14" Glyph="&#xE74A;" />
                            </Button>
                            <Button
                                x:Name="MoveDownButton"
                                Grid.Column="4"
                                AutomationProperties.AutomationId="MoveDownButton"
                                AutomationProperties.Name="Move down"
                                Click="OnMoveDownClick"
                                ToolTipService.ToolTip="Move down">
                                <FontIcon FontSize="14" Glyph="&#xE74B;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!--  The selected snippet.  -->
                <Border
                    Grid.Column="1"
                    Padding="16"
                    Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid x:Name="SnippetEditor" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SnippetCaption" Style="{StaticResource SectionLabelTextStyle}" />
                            <TextBox
                                x:Name="TitleBox"
                                Grid.Row="1"
                                AutomationProperties.AutomationId="SnippetTitleBox"
                                AutomationProperties.Name="Title"
                                PlaceholderText="Title (optional)"
                                TextChanged="OnTitleChanged" />
                            <TextBox
                                x:Name="SnippetBox"
                                Grid.Row="2"
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="SnippetTextBox"
                                AutomationProperties.Name="Snippet text"
                                FontFamily="Cascadia Mono, Consolas"
                                IsSpellCheckEnabled="False"
                                PlaceholderText="A command or prompt to paste"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                TextChanged="OnSnippetTextChanged"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="Text is copied exactly, including line breaks. The app never runs commands or presses Enter."
                                TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel
                            x:Name="NoSelectionState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                            <FontIcon Glyph="&#xE70F;" Style="{StaticResource EmptyStateIconStyle}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Select a snippet" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="Edit commands and prompts here." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--  Footer: import, settings, and whatever needs attention.  -->
            <StackPanel
                Grid.Row="2"
                Padding="24,12,24,16"
                Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="ImportButton"
                        AutomationProperties.AutomationId="ImportMarkdownButton"
                        AutomationProperties.Name="Import"
                        Click="OnImportClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                            <TextBlock Text="Import…" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Opening="OnSettingsFlyoutOpening" Placement="TopEdgeAlignedLeft">
                                <!--  Wide enough for the settings cards to keep their side-by-side layout.  -->
                                <Flyout.FlyoutPresenterStyle>
                                    <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                        <Setter Property="MaxWidth" Value="560" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Width="500" Spacing="4">
                                    <toolkit:SettingsCard
                                        AutomationProperties.AutomationId="PasteDetectionCard"
                                        Description="Copy the next snippet when you paste the current one."
                                        Header="Paste detection">
                                        <ToggleSwitch
                                            x:Name="DetectionSwitch"
                                            AutomationProperties.Name="Paste detection"
                                            Toggled="OnDetectionToggled" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        AutomationProperties.AutomationId="TerminalShortcutsCard"
                                        Description="Also treat Ctrl+Shift+V and Shift+Insert as a paste."
                                        Header="Terminal paste shortcuts">
                                        <ToggleSwitch
                                            x:Name="TerminalSwitch"
                                            AutomationProperties.Name="Terminal paste shortcuts"
                                            Toggled="OnTerminalShortcutsToggled" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        AutomationProperties.AutomationId="NextAfterCard"
                                        Description="Wait after a paste before the next snippet is copied. Raise it if a slow app pastes the wrong snippet."
                                        Header="Next after">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Slider
                                                x:Name="DelaySlider"
                                                Width="130"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Next after"
                                                Maximum="3000"
                                                Minimum="100"
                                                StepFrequency="50"
                                                ValueChanged="OnDelayChanged" />
                                            <TextBlock
                                                x:Name="DelayText"
                                                MinWidth="44"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryBodyTextStyle}" />
                                        </StackPanel>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        AutomationProperties.AutomationId="FloatingBadgeCard"
                                        Description="A small always-on-top progress badge you can drag anywhere."
                                        Header="Floating badge">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="ResetBadgeButton"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="ResetBadgePositionButton"
                                                Click="OnResetBadgeClick"
                                                Content="Reset position" />
                                            <ToggleSwitch
                                                x:Name="BadgeSwitch"
                                                AutomationProperties.Name="Floating badge"
                                                Toggled="OnBadgeToggled" />
                                        </StackPanel>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        x:Name="StartupCard"
                                        AutomationProperties.AutomationId="StartWithWindowsCard"
                                        Header="Start with Windows">
                                        <ToggleSwitch
                                            x:Name="StartupSwitch"
                                            AutomationProperties.Name="Start with Windows"
                                            Toggled="OnStartupToggled" />
                                    </toolkit:SettingsCard>
                                    <Grid Margin="4,8,4,0" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="VersionText"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryCaptionTextStyle}" />
                                        <HyperlinkButton
                                            Grid.Column="1"
                                            Content="Website"
                                            NavigateUri="https://clipboardnext.com/" />
                                        <HyperlinkButton
                                            Grid.Column="2"
                                            Content="Privacy"
                                            NavigateUri="https://clipboardnext.com/privacy.html" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <StackPanel
                        x:Name="DetectionOnIndicator"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="PasteDetectionOnIndicator"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="Collapsed">
                        <FontIcon Glyph="&#xE73E;" Style="{StaticResource SuccessIconStyle}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="Paste detection on" />
                    </StackPanel>
                </StackPanel>

                <InfoBar
                    x:Name="DetectionBar"
                    AutomationProperties.AutomationId="PasteDetectionBar"
                    IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button
                            x:Name="DetectionActionButton"
                            AutomationProperties.AutomationId="PasteDetectionActionButton"
                            Click="OnDetectionActionClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    x:Name="MessageBar"
                    AutomationProperties.AutomationId="QueueMessageBar"
                    IsClosable="False"
                    Severity="Informational" />

                <InfoBar
                    x:Name="StorageBar"
                    Title="Queue file"
                    AutomationProperties.AutomationId="StorageErrorBar"
                    IsClosable="False"
                    Severity="Error">
                    <InfoBar.ActionButton>
                        <Button AutomationProperties.AutomationId="SaveCurrentQueueButton" Content="Save current queue…">
                            <Button.Flyout>
                                <Flyout x:Name="ReplaceSavedFlyout" Placement="Top">
                                    <StackPanel MaxWidth="300" Spacing="12">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="Save the current queue, replacing any existing saved file?"
                                            TextWrapping="Wrap" />
                                        <Button
                                            AutomationProperties.AutomationId="ConfirmReplaceSavedQueueButton"
                                            Click="OnReplaceSavedQueueConfirmed"
                                            Content="Replace saved queue" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Grid>

        <local:ImportView
            x:Name="ImportPage"
            Grid.Row="1"
            Visibility="Collapsed" />
    </Grid>
</Window>
