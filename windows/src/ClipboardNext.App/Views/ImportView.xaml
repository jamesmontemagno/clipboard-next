<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClipboardNext.App.ImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Paste or open source text, preview the snippets found, then append or replace.  -->
    <Grid Padding="24,8,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Width="36"
                Height="36"
                Padding="6"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ImportBackButton"
                AutomationProperties.Name="Back to queue"
                Click="OnCancelClick"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Back to queue">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Import snippets" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="OpenMarkdownFileButton"
                AutomationProperties.Name="Open file"
                Click="OnOpenFileClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                    <TextBlock Text="Open file…" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock VerticalAlignment="Center" Text="Format" />
            <SelectorBar
                x:Name="ImportFormatSelector"
                AutomationProperties.AutomationId="ImportFormatSelector"
                AutomationProperties.Name="Import format"
                SelectionChanged="OnFormatChanged">
                <SelectorBarItem
                    x:Name="MarkdownFormatItem"
                    AutomationProperties.AutomationId="MarkdownFormatItem"
                    Text="Markdown" />
                <SelectorBarItem
                    x:Name="PlainTextFormatItem"
                    AutomationProperties.AutomationId="PlainTextFormatItem"
                    Text="Plain Text" />
            </SelectorBar>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="MarkdownBox"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="MarkdownBox"
                AutomationProperties.Name="Presenter notes"
                FontFamily="Cascadia Mono, Consolas"
                IsSpellCheckEnabled="False"
                PlaceholderText="Paste your Markdown presenter notes here, or open a file."
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextChanged="OnMarkdownChanged"
                TextWrapping="NoWrap" />

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <ListView
                        x:Name="CandidateList"
                        Padding="0,4"
                        AutomationProperties.AutomationId="ImportCandidateList"
                        AutomationProperties.Name="Snippets found"
                        SelectionMode="None" />
                    <StackPanel
                        x:Name="PreviewEmptyState"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" Style="{StaticResource EmptyStateIconStyle}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Preview before importing" />
                        <TextBlock
                            x:Name="PreviewGuidanceText"
                            HorizontalAlignment="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="Code blocks are selected by default. Blockquoted prompts are optional."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <CheckBox
            x:Name="WholeBlocksCheck"
            Grid.Row="3"
            AutomationProperties.AutomationId="WholeBlocksCheck"
            Checked="OnWholeBlocksChanged"
            Content="Keep each code block as one multiline snippet"
            Unchecked="OnWholeBlocksChanged" />

        <TextBlock
            x:Name="ImportHelpText"
            Grid.Row="4"
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="By default, each nonblank code line becomes a snippet. Splitting is not shell-aware: keep whole blocks for continuations or scripts. Review commands before pasting."
            TextWrapping="Wrap" />

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="5"
            AutomationProperties.AutomationId="ImportErrorBar"
            IsClosable="False"
            Severity="Error" />

        <Grid Grid.Row="6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                AutomationProperties.AutomationId="ImportCancelButton"
                Click="OnCancelClick"
                Content="Cancel" />
            <Button
                x:Name="PreviewButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="ImportPreviewButton"
                Click="OnPreviewClick"
                Content="Preview" />
            <TextBlock
                x:Name="SelectedCountText"
                Grid.Column="3"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ImportSelectedCountText"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource SecondaryBodyTextStyle}" />
            <Button
                x:Name="ReplaceButton"
                Grid.Column="4"
                AutomationProperties.AutomationId="ImportReplaceButton"
                Click="OnReplaceClick"
                Content="Replace queue…">
                <FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="ReplaceFlyout" Placement="Top">
                        <StackPanel MaxWidth="280" Spacing="12">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Replace all existing snippets?"
                                TextWrapping="Wrap" />
                            <Button
                                AutomationProperties.AutomationId="ConfirmReplaceQueueButton"
                                Click="OnReplaceConfirmed"
                                Content="Replace queue" />
                        </StackPanel>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </Button>
            <Button
                x:Name="AppendButton"
                Grid.Column="5"
                AutomationProperties.AutomationId="ImportAppendButton"
                Click="OnAppendClick"
                Content="Append to queue"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
