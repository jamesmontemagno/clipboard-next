<?xml version="1.0" encoding="utf-8"?>

<!--
  The Microsoft Store package manifest. Identity Name and Publisher must match the values
  Partner Center shows under Product identity for the reserved name "Clipboard Next"; see
  windows/docs/microsoft-store-listing.md. The release workflow stamps Version from the tag.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="23875RefractoredLLC.ClipboardNext"
    Publisher="CN=995C4AD9-3B22-4B61-B30F-3EAB23CDAEAE"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Clipboard Next</DisplayName>
    <PublisherDisplayName>Refractored LLC</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Clipboard Next"
        Description="Queue demo commands and prompts, then paste them one at a time."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Optional "Start with Windows", off until the user turns it on in the app. -->
        <uap5:Extension
          Category="windows.startupTask"
          Executable="ClipboardNext.App.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask
            TaskId="ClipboardNextLaunchAtLogin"
            Enabled="false"
            DisplayName="Clipboard Next" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
